POTIM  = 0.3
ISMEAR = 1          ! Methfessel-Paxton for metals
SIGMA  = 0.10
ISPIN  = 1
PREC   = Normal
LREAL  = Auto       ! 459 atoms
ALGO   = Fast
NELM   = 120
LWAVE  = .FALSE.
LCHARG = .FALSE.
